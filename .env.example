# Google Gemini API Key (Required)
GOOGLEAI_STUDIO_KEY=your_gemini_api_key_here
# Alternative environment variable names recognized:
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here

# PostgreSQL Vector Store URL (Default: local Docker container)
DATABASE_URL=postgresql://rag:rag@localhost:5432/corrective_rag

# Tavily Web Search API Key (Optional - falls back to DuckDuckGo if omitted)
TAVILY_API_KEY=your_tavily_api_key_here

# Model Configurations (Optional)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EVAL_MODEL=gemini-3.5-flash-lite
